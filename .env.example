# Environment variables for LogbookLM
# Copy this file to .env and populate before starting Docker

# JWT signing secret — use a long random string in production
JWT_SECRET=changeme-replace-with-a-strong-random-secret

# Anthropic API key — required for Phase 2 AI features
ANTHROPIC_API_KEY=sk-ant-...

# Ollama host for local embeddings (nomic-embed-text)
# Windows/Mac Docker: http://host.docker.internal:11434
# Linux/VPS: http://172.17.0.1:11434
OLLAMA_HOST=http://host.docker.internal:11434
