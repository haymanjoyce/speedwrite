# Environment variables for SpeedWrite
# Copy this file to .env and populate before starting Docker

# JWT signing secret — use a long random string in production
JWT_SECRET=changeme-replace-with-a-strong-random-secret

# Anthropic API key — required for Phase 2 AI features
ANTHROPIC_API_KEY=sk-ant-...

# Encryption key for BYOK key storage — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-this-before-use

# Ollama host — on Linux VPS use the Docker bridge gateway IP
# On Windows/Mac (local dev): http://host.docker.internal:11434
# On Linux VPS: http://172.17.0.1:11434
OLLAMA_HOST=http://172.17.0.1:11434

# SendGrid — required for password reset emails
SENDGRID_API_KEY=SG.your-key-here
EMAIL_FROM=noreply@speedwrite.app
# Address to receive feedback emails. Defaults to EMAIL_FROM if not set.
# FEEDBACK_EMAIL=feedback@speedwrite.app

# Public URL of the app — used in reset email links
APP_URL=https://speedwrite.app

# Ollama chat path is dormant — LLM_PROVIDER and OLLAMA_CHAT_MODEL are not active.
# Uncomment and set LLM_PROVIDER=ollama (plus a UI toggle) to re-enable.
# LLM_PROVIDER=anthropic
# OLLAMA_CHAT_MODEL=llama3.2
